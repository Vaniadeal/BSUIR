                                                    rdfs:subClassOf <http://example.org/ontology/kindergarten#Человек> ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://example.org/ontology/kindergarten#ПосещаетГруппу> ;
                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                      owl:onClass <http://example.org/ontology/kindergarten#Группа>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://example.org/ontology/kindergarten#имеетВозраст> ;
                                                                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                      owl:onDataRange xsd:integer
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://example.org/ontology/kindergarten#имеетВозраст> ;
                                                                      owl:maxQualifiedCardinality "7"^^xsd:nonNegativeInteger ;
                                                                      owl:onDataRange xsd:integer
                                                                    ] .


###  http://example.org/ontology/kindergarten#Родитель
<http://example.org/ontology/kindergarten#Родитель> rdf:type owl:Class ;
