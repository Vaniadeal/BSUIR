set_theoretic_ontology_of_subject_domain_of_kindergarten
= [*
<- concept_set_theoretic_ontology_of_subject_domain;;

concept_human
=> nrel_main_idtf: [человек] (* <- lang_ru;; *);
=> nrel_subdividing: {
 concept_child;
 concept_parent;
 concept_employee
};;

concept_employee
=> nrel_main_idtf: [сотрудник] (* <- lang_ru;; *);
=> nrel_subdividing: {
 concept_cook;
 concept_educator;
 concept_nurse
};;

concept_child
=> nrel_main_idtf: [ребенок] (* <- lang_ru;; *);
=> nrel_inclusion: concept_human;;

concept_parent
=> nrel_main_idtf: [родитель] (* <- lang_ru;; *);
=> nrel_inclusion: concept_human;;

concept_employee
=> nrel_inclusion: concept_human;;

concept_cook
=> nrel_main_idtf: [повар] (* <- lang_ru;; *);
=> nrel_inclusion: concept_employee;;

concept_educator
=> nrel_main_idtf: [воспитатель] (* <- lang_ru;; *);
=> nrel_inclusion: concept_employee;;

concept_nurse
=> nrel_main_idtf: [медсестра] (* <- lang_ru;; *);
=> nrel_inclusion: concept_employee;;

concept_group
=> nrel_main_idtf: [группа детского сада] (* <- lang_ru;; *);;

nrel_visits_group
=> nrel_main_idtf: [посещает группу*] (* <- lang_ru;; *);;

nrel_has_parent
=> nrel_main_idtf: [имеет родителя*] (* <- lang_ru;; *);;

nrel_treats
=> nrel_main_idtf: [лечит*] (* <- lang_ru;; *);;

nrel_works_in_group
=> nrel_main_idtf: [работает в группе*] (* <- lang_ru;; *);;

nrel_has_age
=> nrel_main_idtf: [возраст*] (* <- lang_ru;; *);;

nrel_has_name
=> nrel_main_idtf: [имя*] (* <- lang_ru;; *);;

nrel_has_experience
=> nrel_main_idtf: [стаж работы*] (* <- lang_ru;; *);;

nrel_has_phone_number
=> nrel_main_idtf: [номер телефона*] (* <- lang_ru;; *);;

nrel_cooks_for
=> nrel_main_idtf: [готовит для*] (* <- lang_ru;; *);;

*];;


